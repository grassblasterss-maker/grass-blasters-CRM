# Inbound calls from Zapier to Grass Blasters OS
ZAPIER_WEBHOOK_SECRET=replace-with-a-long-random-value

# Outbound calls from the dashboard/API to Zapier Catch Raw Hooks
ZAPIER_ACTION_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/replace/me
ZAPIER_TABLES_INTAKE_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/replace/me
ZAPIER_OUTBOUND_SIGNING_SECRET=replace-with-a-different-long-random-value

# Protects /api/tools/execute. Never expose this to browser JavaScript.
GRASS_BLASTERS_API_KEY=replace-with-a-long-random-value

# Red-risk actions stay disabled unless explicitly enabled after testing.
ALLOW_RED_TOOLS=false

# Jarvis 0.4 browser access (Clerk managed sessions, no shared API key in browser)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
JARVIS_APP_ORIGIN=https://grass-blasters-crm.vercel.app
JARVIS_OWNER_EMAILS=
JARVIS_ASSISTANT_EMAILS=

# Initial read-only Jobber pilot; durable OAuth refresh still needs implementation
JOBBER_ACCESS_TOKEN=
JOBBER_API_VERSION=
